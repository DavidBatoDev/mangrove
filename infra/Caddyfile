# Public entrypoint. DOMAIN comes from the environment (e.g. 18-140-211-157.sslip.io).
{$DOMAIN} {
	encode gzip

	# Read-only MCP server for Amazon Quick (Streamable HTTP; path kept as /mcp, no prefix stripping)
	handle /mcp* {
		reverse_proxy mcp:8000 {
			flush_interval -1
		}
	}

	# Evidence API (routes are served under /api by the API itself, no prefix stripping)
	handle /api/* {
		reverse_proxy api:8000
	}

	# Web app
	handle {
		reverse_proxy web:3000
	}
}
