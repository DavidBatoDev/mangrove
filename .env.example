# Variable names only. Real values live outside the repo (never commit them). docs/security.md §7.
# Public host
DOMAIN=
PUBLIC_BASE_URL=
MCP_PUBLIC_URL=
# Neon Postgres + PostGIS (ADR-036): pooled for the app, direct for migrations/owner role
DATABASE_URL=
DATABASE_URL_DIRECT=
DATABASE_APP_ROLE=
# Neon test branch, for pytest only; never the demo branch (docs/tests.md §4)
TEST_DATABASE_URL=
TEST_DATABASE_URL_DIRECT=
# Sessions and seeded demo accounts (docs/security.md §4)
SESSION_SECRET=
DEMO_FUNDER_PASSWORD=
DEMO_PARTNER_PASSWORD=
# S3 asset store via the EC2 instance role, no keys (ADR-037)
AWS_REGION=ap-southeast-1
S3_BUCKET=
# Copernicus Data Space: unused since ADR-042 (Sentinel-2 comes from Earth Search, no account); kept for a possible return
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=
CDSE_SH_BASE_URL=
# Web
# Google Maps display layer (ADR-046), inlined into the web build; restrict it to the demo domain
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_BASEMAP_URL=
# Server-side calls from the web app to the API (compose: http://api:8000; local dev: http://localhost:8000)
API_INTERNAL_URL=
# true = screens read web/mocks fixtures (ADR-038); must be unset/false in the deployed build
NEXT_PUBLIC_USE_MOCKS=
# Optional, F-013 (Could) only
OPENAI_API_KEY=
OPENAI_MODEL=
# Host folder with the Philippines GMW extent layer (ADR-048); default /opt/bon/gmw-tiles
GMW_TILE_DIR_HOST=
