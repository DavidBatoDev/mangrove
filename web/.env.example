# P0: read fixtures in web/mocks/ instead of the API (never in production, ADR-038).
NEXT_PUBLIC_USE_MOCKS=true
# Basemap tiles; empty = EOxCloudless 2016 (docs/prd.md §7).
NEXT_PUBLIC_BASEMAP_URL=
# Where server code and the dev rewrite reach the API.
API_INTERNAL_URL=http://localhost:8000
# Google Maps JavaScript API (display only: 2D satellite map and 3D site views; evidence stays GMW + Sentinel-2).
# Empty = MapLibre everywhere. Restrict the key to HTTP referrers (your domain, localhost:3000) and to the
# Maps JavaScript API in Google Cloud; it is visible in the browser.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Map ID for the 2D map's advanced markers; empty = Google's DEMO_MAP_ID for development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Where the mangrove extent map tiles come from (ADR-049). Empty = same origin (deployed) or the live API (fixtures mode).
NEXT_PUBLIC_GMW_TILES_ORIGIN=
